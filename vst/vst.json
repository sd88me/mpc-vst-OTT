{
  "name": "OTTmpc",
  "vendor": "sd88me",
  "uid": "vOTx",
  "version": 1000,
  "so": "ottmpc.so",
  "params": "params.json",
  "layout": "layout.conf",
  "art": "html",
  "effect": true,
  "defines": {
    "HAS_DISPLAY_REV": 1,
    "DISPLAY_REV_NO_UPDATE": 1
  },
  "build": {
    "root": "..",
    "sources": [
      "src/engine.cpp",
      "src/vital_dsp/compressor.cpp",
      "src/vital_dsp/linkwitz_riley_filter.cpp",
      "src/vital_dsp/framework/processor.cpp",
      "src/vital_dsp/framework/value.cpp",
      "src/vital_dsp/framework/utils.cpp",
      "src/vital_dsp/framework/operators.cpp",
      "src/vital_dsp/utilities/smooth_value.cpp"
    ],
    "cflags": [
      "-std=gnu++17",
      "-Isrc",
      "-Isrc/vital_dsp",
      "-ffast-math"
    ],
    "libs": [
      "-lm"
    ],
    "cflags_arm": [
      "-mfpu=neon",
      "-DNEON_ARM32"
    ]
  },
  "presets": "presets.json"
}
